namespace Am.Git
{
    // Represents an on-disk git repository - specifically, the .git
    // directory layout. We only create the bits a freshly-cloned repo
    // needs: HEAD, refs/heads, refs/tags, objects/pack, plus a `config`
    // file with the remote configured. No working tree checkout yet.
    class Repository(private var workTreePath: String)
    {
        import Am.Lang
        import Am.Collections
        import Am.IO

        private var gitDirPath: String? = null

        fun getGitDir(): String {
            return this.gitDirPath
        }

        fun getWorkTree(): String {
            return this.workTreePath
        }

        // Build the .git skeleton on disk, with `defaultBranch` recorded
        // in HEAD. The branch's ref file is *not* written here - that's
        // the job of the clone code, which only knows the SHA after the
        // ref advertisement comes back.
        static fun init(workTreePath: String, defaultBranch: String, bare: Bool): Repository {
            var repo = new Repository(workTreePath)
            if (bare) {
                repo.gitDirPath = workTreePath
            } else {
                repo.gitDirPath = workTreePath + "/.git"
            }

            Repository.ensureDir(workTreePath)
            Repository.ensureDir(repo.gitDirPath)
            Repository.ensureDir(repo.gitDirPath + "/objects/pack")
            Repository.ensureDir(repo.gitDirPath + "/objects/info")
            Repository.ensureDir(repo.gitDirPath + "/refs/heads")
            Repository.ensureDir(repo.gitDirPath + "/refs/tags")

            var headContent = "ref: refs/heads/" + defaultBranch + "\n"
            headContent.writeToFile(repo.gitDirPath + "/HEAD")

            return repo
        }

        // Persist a remote config - `[remote "origin"] url = <url>` plus
        // a default fetch refspec. Mimics what `git clone` writes so
        // subsequent `git fetch`/`git pull` from a real git binary work.
        fun writeRemoteConfig(remoteName: String, url: String, defaultBranch: String) {
            var sb = new StringBuilder()
            sb.add("[core]\n")
            sb.add("\trepositoryformatversion = 0\n")
            sb.add("\tfilemode = true\n")
            sb.add("\tbare = false\n")
            sb.add("\tlogallrefupdates = true\n")
            sb.add("[remote \"").add(remoteName).add("\"]\n")
            sb.add("\turl = ").add(url).add("\n")
            sb.add("\tfetch = +refs/heads/*:refs/remotes/").add(remoteName).add("/*\n")
            sb.add("[branch \"").add(defaultBranch).add("\"]\n")
            sb.add("\tremote = ").add(remoteName).add("\n")
            sb.add("\tmerge = refs/heads/").add(defaultBranch).add("\n")

            sb.toString().writeToFile(this.gitDirPath + "/config")
        }

        fun writeRef(refName: String, sha: String) {
            var refPath = this.gitDirPath + "/" + refName
            Repository.ensureParentDir(refPath)
            (sha + "\n").writeToFile(refPath)
        }

        fun objectsPackDir(): String {
            return this.gitDirPath + "/objects/pack"
        }

        // Write a binary blob to a file at the given absolute path,
        // creating any required parents.
        static fun writeBytes(path: String, bytes: UByte[]) {
            Repository.ensureParentDir(path)
            var file = new File(path)
            var stream = new FileStream(file, FileAccess.writeOnly)
            stream.write(bytes, 0L, bytes.length())
            stream.close()
        }

        // mkdir -p - create every missing component along the way.
        // The native File.createDirectory only mkdirs the leaf.
        // Strip the POSIX-isms AmigaDOS does not understand.
        //
        // AmigaDOS has no "." entry: "." is an ordinary filename, so a path
        // built as `"." + "/.git"` names a DRAWER called "." with .git
        // inside it. `init` did exactly that -- it filled in a decoy while
        // every reader used a plain ".git", so HEAD went missing and every
        // commit and status failed with "not a git repository". Nothing
        // failed loudly; POSIX collapses "./" silently, so it only ever
        // showed up on Amiga.
        //
        // This is am-git's job, not the runtime's: a library client knows
        // which path forms it builds, and hands the platform what that
        // platform expects. So every path am-git composes or accepts from
        // the user goes through here first.
        //
        // ".." is deliberately NOT translated. On Amiga the parent is a
        // leading "/", but rewriting it would be wrong on every other
        // platform, and am-git never builds a path containing it.
        static fun normalizePath(path: String): String {
            var p = path
            // Leading "./" runs, then a bare ".".
            while (p.startsWith("./")) {
                p = p.substringToEnd(2UI)
            }
            if (p == ".") {
                return ""
            }
            // Interior "/./".
            var at = p.indexOf("/./")
            while (at >= 0) {
                p = p.substring(0UI, at.toUInt()) + p.substringToEnd((at + 2).toUInt())
                at = p.indexOf("/./")
            }
            // Trailing "/." and any trailing separator.
            while (p.length() > 1 && p.endsWith("/.")) {
                p = p.substring(0UI, (p.length() - 2).toUInt())
            }
            while (p.length() > 1 && p.endsWith("/")) {
                p = p.substring(0UI, (p.length() - 1).toUInt())
            }
            return p
        }

        // Resolve a work-tree argument to a path the filesystem will
        // actually accept.
        //
        // AmigaOS has no "." entry: `.` is an ordinary filename, so a
        // path built as `"." + "/.git"` names a DRAWER called "." with
        // `.git` inside it -- a decoy repository that init would fill
        // in while every other command, which uses a plain `.git`,
        // looked at the real one. That cost a working `init` on
        // AmigaOS: HEAD landed in the decoy and every commit and
        // status then failed with "HEAD not found". POSIX collapses
        // `./` silently, which is why it only ever showed up on
        // Amiga.
        //
        // Four classes had grown their own copy of this guard; this is
        // the one they now share. Callers must route every work-tree
        // path through it before joining anything onto it.
        static fun resolveWorkTree(path: String?): String {
            if (path == null) {
                return File.getCurrentDirectory()
            }
            var p = Repository.normalizePath(path as String)
            if (p.length() == 0) {
                return File.getCurrentDirectory()
            }
            // Trailing separator would double up in `p + "/" + rel`.
            while (p.length() > 1 && p.endsWith("/")) {
                p = p.substring(0UI, (p.length() - 1).toUInt())
            }
            return p
        }

        // Where the repository state of work tree `workTree` ("" for the
        // cwd) lives. Normally `<workTree>/.git`, a directory. In a linked
        // work tree (`git worktree add`) `.git` is a FILE holding
        // `gitdir: <path>` - the per-work-tree directory (HEAD, index,
        // MERGE_HEAD, rebase state...) under the main repository's
        // `.git/worktrees/<name>`; that is what is returned then. Objects,
        // refs and config are NOT there - see commonDir(). A relative
        // gitdir is relative to the work tree. Without a .git at all the
        // plain `<workTree>/.git` comes back and the caller's "not a
        // repository" path fires as before.
        static fun resolveGitDir(workTree: String): String {
            var dotGit = ".git"
            if (workTree.length() > 0) {
                dotGit = workTree + "/.git"
            }
            var f = new File(dotGit)
            var isDir = false
            try {
                isDir = f.isDirectory()
            } catch (ex: Exception) {
                return dotGit
            }
            if (isDir || !f.exists()) {
                return dotGit
            }
            var content = String.readFromFile(dotGit).trim()
            if (!content.startsWith("gitdir: ")) {
                return dotGit
            }
            var target = content.substringToEnd(8UI).trim()
            if (target.length() == 0) {
                return dotGit
            }
            if (Repository.isAbsolute(target) || workTree.length() == 0) {
                return Repository.joinRelative("", target)
            }
            return Repository.joinRelative(workTree, target)
        }

        // The directory every work tree of a repository shares: objects,
        // refs, packed-refs, config, info. A linked work tree's git dir
        // carries a `commondir` file naming it (relative to that dir,
        // "../.." in practice); a git dir without one is its own common
        // dir. Per-work-tree paths (HEAD, index, ORIG_HEAD, MERGE_*,
        // rebase-merge, logs/HEAD) must NOT go through here.
        static fun commonDir(gitDir: String): String {
            var marker = gitDir + "/commondir"
            var f = new File(marker)
            if (!f.exists()) {
                return gitDir
            }
            var rel = String.readFromFile(marker).trim()
            if (rel.length() == 0) {
                return gitDir
            }
            if (Repository.isAbsolute(rel)) {
                return Repository.joinRelative("", rel)
            }
            return Repository.joinRelative(gitDir, rel)
        }

        // "/x" on POSIX; "Vol:x" on AmigaDOS (a colon before any slash).
        static fun isAbsolute(path: String): Bool {
            if (path.startsWith("/")) {
                return true
            }
            var colon = path.indexOf(":")
            if (colon < 0) {
                return false
            }
            var slash = path.indexOf("/")
            return slash < 0 || colon < slash
        }

        // Join `rel` onto `base`, folding "." and ".." segments as they
        // are met so the result never contains them: ".." drops the last
        // segment of what has been built so far. AmigaDOS has no ".."
        // and POSIX code paths elsewhere in am-git never build one, so
        // this keeps a `commondir` of "../.." usable everywhere.
        static fun joinRelative(base: String, rel: String): String {
            var parts = List<String>.newList<String>()
            var absolute = base.startsWith("/") || rel.startsWith("/")
            var baseSegs = base.split(47US)
            var i = 0
            while (i < baseSegs.length().toInt()) {
                var seg = baseSegs[i.toUInt()]
                if (seg.length() > 0 && seg != ".") {
                    parts.add(seg)
                }
                i = i + 1
            }
            var relSegs = rel.split(47US)
            var j = 0
            while (j < relSegs.length().toInt()) {
                var seg = relSegs[j.toUInt()]
                if (seg == "..") {
                    if (parts.getSize() > 0 && parts.get(parts.getSize() - 1) != "..") {
                        parts.removeAt(parts.getSize() - 1)
                    } else {
                        parts.add(seg)
                    }
                } else if (seg.length() > 0 && seg != ".") {
                    parts.add(seg)
                }
                j = j + 1
            }
            var sb = new StringBuilder()
            if (absolute) {
                sb.add("/")
            }
            var k = 0
            while (k < parts.getSize()) {
                if (k > 0) {
                    sb.add("/")
                }
                sb.add(parts.get(k))
                k = k + 1
            }
            return sb.toString()
        }

        static fun ensureParentDir(path: String) {
            var lastSlash = path.lastIndexOf("/")
            if (lastSlash <= 0) {
                return
            }
            var dir = path.substring(0UI, lastSlash.toUInt())
            Repository.ensureDir(dir)
        }

        static fun ensureDir(path: String) {
            // Build the path one segment at a time, mkdir-ing each. Existing
            // directories make mkdir return false - we don't care. Only the
            // final fopen() call has to succeed.
            if (path.length() == 0) {
                return
            }
            var len = path.length().toUInt()
            var i = 1UI
            while (i <= len) {
                if (i == len || path.characterAt(i) == 47US) {
                    var prefix = path.substring(0UI, i)
                    File.createDirectory(prefix)
                }
                i++
            }
        }
    }
}
