namespace Am.Git
{
    // `git checkout <branch>` - switch HEAD to a local branch and
    // bring the working tree in line with that branch's tip.
    //
    // Algorithm:
    //   1. Resolve `refs/heads/<branch>` to a commit SHA.
    //   2. Load every object reachable from that commit into memory
    //      so the existing WorkTree code can materialise the tree.
    //   3. Build the set of file paths the new tree expects.
    //   4. Walk the working tree and delete any file (or empty subdir)
    //      that the new tree doesn't include. This is what makes the
    //      checkout coherent - without it, files that existed on the
    //      old branch but not the new one would linger.
    //   5. Write the new tree's blobs over the working tree.
    //   6. Repoint `HEAD` at `refs/heads/<branch>`.
    //
    // What it doesn't do yet:
    //   * Checkout by raw commit SHA (detached HEAD) - branch only.
    //   * Restore executable mode / symlinks (same gap as `clone`).
    class CheckoutClient
    {
        import Am.Lang
        import Am.Collections
        import Am.IO

        // workTreePath is typically "." (current working dir).
        // gitDir is typically ".git".
        static fun checkout(gitDir: String, workTreePath: String?, branch: String) {
            // Resolve "."/"" to an absolute path - see StatusReport.run
            // for the rationale (opendir(".") is unreliable on
            // amiga-gcc without ixemul).
            workTreePath = Repository.resolveWorkTree(workTreePath)
            // Loose or packed (RefStore) - real-git clones keep branch
            // refs in packed-refs until first written.
            var commitSha = RefStore.resolve(gitDir, "refs/heads/" + branch)
            if (commitSha == null) {
                throw new Exception("checkout: refs/heads/" + branch + " does not exist")
            }
            if (commitSha.length() != 40) {
                throw new Exception("checkout: ref content not a SHA: " + commitSha)
            }

            // Apply the commit's tree to the working tree + index.
            // applyCommitToWorkTree handles object loading, orphan
            // pruning, blob writing, and index re-seeding. `true` =
            // refuse to clobber local changes (real-git behaviour);
            // the force paths (reset --hard, rebase, ...) pass false.
            CheckoutClient.applyCommitToWorkTree(gitDir, workTreePath, commitSha, true)

            // Update HEAD to track the branch symbolically.
            ("ref: refs/heads/" + branch + "\n").writeToFile(gitDir + "/HEAD")

            ("Switched to branch " + branch + " at " + commitSha).println()
        }

        // Apply `commitSha`'s tree to the working tree and re-seed
        // the index from it. Does NOT touch HEAD or any ref - that's
        // the caller's responsibility. Used by both `checkout`
        // (which updates HEAD after) and `reset --hard` / rebase /
        // cherry-pick / revert (which update refs themselves).
        //
        // `guardLocalChanges` = real-git checkout safety: refuse when
        // tracked files have local (staged or unstaged) changes, or
        // when an untracked file would be overwritten by the target
        // tree. The force paths (reset --hard etc.) pass false — but
        // even they PRESERVE untracked files now: orphan removal only
        // deletes files the current index tracks, matching git.
        //
        // Reachable objects are loaded eagerly into a map, which
        // avoids the same-process loose-read fragility on AmigaOS
        // (see GitIndex.fromTreeMap for the underlying fix).
        static fun applyCommitToWorkTree(gitDir: String, workTreePath: String, commitSha: String, guardLocalChanges: Bool) {
            var store = new ObjectStore(gitDir)
            var walker = new ObjectWalker(store)
            var shas = walker.collect(commitSha, "0000000000000000000000000000000000000000")
            var objects = new HashMap<String, PackObject>()
            var i = 0
            while (i < shas.getSize()) {
                var sha = shas.get(i)
                if (store.has(sha)) {
                    objects.set(sha, store.read(sha))
                }
                i = i + 1
            }
            if (!objects.containsKey(commitSha)) {
                throw new Exception("commit " + commitSha + " not present in object store")
            }

            // Expected set of file paths under workTreePath, relative.
            var expected = new HashMap<String, Bool>()
            var commit = objects.get(commitSha)
            var rootTreeSha = WorkTree.extractRootTreeSha(commit.content)
            CheckoutClient.collectExpectedPaths(rootTreeSha, "", expected, objects)

            // Real-git checkout guard: never silently clobber work.
            //  * tracked file with staged/unstaged changes -> refuse
            //  * untracked file that the target tree would overwrite
            //    -> refuse
            // (Untracked files that DON'T collide are simply kept.)
            if (guardLocalChanges) {
                var changes = StatusReport.pathStatus(gitDir, workTreePath)
                var blocked = List<String>.newList<String>()
                var ck = changes.buildKeys()
                var c = 0
                while (c < ck.getSize()) {
                    var p = ck.get(c)
                    var code = changes.get(p)
                    if (code.equals("?")) {
                        if (expected.containsKey(p)) {
                            blocked.add(p + " (untracked, would be overwritten)")
                        }
                    } else {
                        blocked.add(p)
                    }
                    c = c + 1
                }
                if (blocked.getSize() > 0) {
                    var sb = new StringBuilder()
                    sb.add("checkout: your local changes would be overwritten - commit, unstage or reset them first:")
                    var b = 0
                    while (b < blocked.getSize() && b < 8) {
                        sb.add(" ").add(blocked.get(b))
                        b = b + 1
                    }
                    if (blocked.getSize() > 8) {
                        sb.add(" (+" + (blocked.getSize() - 8).toString() + " more)")
                    }
                    throw new Exception(sb.toString())
                }
            }

            // Wipe orphans before writing the new tree, so a file
            // that moved between directories doesn't end up
            // duplicated. Only files the CURRENT index tracks are
            // candidates - untracked files survive a branch switch
            // (and a reset --hard), exactly like real git.
            var trackedNow = GitIndex.read(gitDir).pathToSha()
            CheckoutClient.removeOrphans(workTreePath, "", expected, trackedNow)

            // Re-use the existing tree-writer.
            var wt = new WorkTree(workTreePath, objects)
            wt.checkout(commitSha)

            // Refresh the index so it mirrors the new tree. Without
            // this, `am-git status` would report every file as
            // "staged" after the call. We just wrote the working tree
            // from these very blobs, so back-filling stat info from
            // disk is safe — and without it every later `status` would
            // re-hash the whole tree (zeroed stats never match).
            var seeded = GitIndex.fromTreeMap(rootTreeSha, objects)
            seeded.refreshStatsFromDisk(workTreePath)
            seeded.write(gitDir)
        }

        // Walk the new commit's tree and record every blob's path
        // relative to the work tree root. Tree paths aren't added -
        // empty directories aren't part of git's model.
        private static fun collectExpectedPaths(treeSha: String,
                                                 prefix: String,
                                                 out: HashMap<String, Bool>,
                                                 objects: HashMap<String, PackObject>) {
            if (!objects.containsKey(treeSha)) {
                return
            }
            var tree = objects.get(treeSha)
            if (tree.typeCode != 2) {
                return
            }
            var entries = WorkTree.parseTree(tree.content)
            var i = 0
            while (i < entries.getSize()) {
                var entry = entries.get(i)
                var path: String
                if (prefix.length() == 0) {
                    path = entry.name
                } else {
                    path = prefix + "/" + entry.name
                }
                if (entry.isTree()) {
                    CheckoutClient.collectExpectedPaths(entry.sha, path, out, objects)
                } else if (entry.isFile() || entry.isSymlink()) {
                    out.set(path, true)
                }
                // Submodules and other modes - ignored (matches WorkTree).
                i = i + 1
            }
        }

        // Walk the working tree, removing any file whose relative
        // path isn't in `expected`. Skips `.git` so we don't nuke
        // our own metadata. Removes empty directories on the way up.
        private static fun removeOrphans(workTreePath: String,
                                          relPrefix: String,
                                          expected: HashMap<String, Bool>,
                                          tracked: HashMap<String, String>) {
            var dirPath: String
            if (relPrefix.length() == 0) {
                dirPath = workTreePath
            } else {
                dirPath = workTreePath + "/" + relPrefix
            }
            var dir = new File(dirPath)
            if (!dir.exists()) {
                return
            }
            var entries = dir.listFiles()
            var i = 0
            while (i < entries.length().toInt()) {
                var f = entries[i.toUInt()]
                var name = f.getName()
                if (name == ".git") {
                    i = i + 1
                    continue
                }
                var relPath: String
                if (relPrefix.length() == 0) {
                    relPath = name
                } else {
                    relPath = relPrefix + "/" + name
                }
                if (f.isDirectory()) {
                    CheckoutClient.removeOrphans(workTreePath, relPath, expected, tracked)
                    // Leaving empty directories around is harmless;
                    // we could rmdir them here but listFiles returning
                    // empty is good enough for a sanity check.
                } else {
                    // Delete only files the index tracks that the target
                    // tree drops — an untracked file is the user's, not
                    // ours to clean up.
                    if (!expected.containsKey(relPath) && tracked.containsKey(relPath)) {
                        File.delete(f.toString())
                    }
                }
                i = i + 1
            }
        }
    }
}
