namespace Am.Git
{
    // A parsed git remote URL. Only the smart-HTTP forms are supported for
    // now - `http(s)://[user[:pass]@]host[:port]/path[.git]`. The path is
    // kept verbatim (without a trailing slash) so requests can append
    // `/info/refs?service=...` or `/git-upload-pack` directly.
    class GitUrl(var scheme: String,
                 var host: String,
                 var port: Int,
                 var path: String,
                 var userInfo: String)
    {
        import Am.Lang
        import Am.Collections

        fun isHttps(): Bool {
            return this.scheme == "https"
        }

        fun isSsh(): Bool {
            return this.scheme == "ssh"
        }

        fun isHttp(): Bool {
            return this.scheme == "http" || this.scheme == "https"
        }

        // The ssh client program. Overridable with the AM_GIT_SSH env var
        // (git's GIT_SSH idea) so there's no platform hardcoding: on
        // AmigaOS set `AM_GIT_SSH=bebbossh`, elsewhere the default `ssh`
        // is used. Anything with a compatible CLI works
        // (`ssh <host> <cmd>`, `-p <port>`, `-T`).
        static fun sshProgram(): String {
            var p = Environment.get("AM_GIT_SSH")
            if (p != null && p.length() > 0) {
                return p
            }
            return "ssh"
        }

        // Build the argv that SshChannel.spawn runs to speak `service`
        // ("git-upload-pack" for clone/fetch, "git-receive-pack" for push)
        // over ssh, as a '\n'-joined token list:
        //
        //     <ssh-program>
        //     -T
        //     [-p <port>]
        //     [user@]host
        //     <service> '<path>'
        //
        // (AmLang string literals can't carry a raw newline, so we join
        // with addChar(10).) SshChannel keeps this form verbatim for the
        // libc execvp backend, or flattens the newlines to spaces for the
        // AmigaOS shell backend - the ssh helper re-tokenises there. `-T`
        // = no pseudo-terminal, so the pack stream stays binary-clean; the
        // single-quotes keep an odd path intact when the remote shell
        // re-parses it. No platform check here - the program is env-driven.
        fun sshCommandLine(service: String): String {
            var target = this.host
            if (this.userInfo.length() > 0) {
                target = this.userInfo + "@" + this.host
            }
            var sb = new StringBuilder()
            sb.add(GitUrl.sshProgram())
            sb.addChar(10US)
            sb.add("-T")
            if (this.port != 22) {
                sb.addChar(10US)
                sb.add("-p")
                sb.addChar(10US)
                sb.add(this.port.toString())
            }
            sb.addChar(10US)
            sb.add(target)
            sb.addChar(10US)
            sb.add(service + " '" + this.path + "'")
            return sb.toString()
        }

        // Interactive command (run via Process.run, inheriting the
        // terminal / CLI) whose only purpose is to make the ssh helper
        // connect so it prompts to accept the host key. A space-joined
        // shell string (Process.run goes through the shell). The remote
        // command is benign `true` - the host-key prompt fires during the
        // SSH handshake, before the command runs, so it works even when
        // the remote's git-shell would reject `true`. NOT `-T` here: we
        // want the interactive prompt to reach the user.
        fun sshTrustCommand(): String {
            var target = this.host
            if (this.userInfo.length() > 0) {
                target = this.userInfo + "@" + this.host
            }
            var sb = new StringBuilder()
            sb.add(GitUrl.sshProgram())
            sb.add(" ")
            if (this.port != 22) {
                sb.add("-p ")
                sb.add(this.port.toString())
                sb.add(" ")
            }
            sb.add(target)
            sb.add(" true")
            return sb.toString()
        }

        fun infoRefsPath(service: String): String {
            return this.path + "/info/refs?service=" + service
        }

        fun servicePath(service: String): String {
            return this.path + "/" + service
        }

        override fun toString(): String {
            // toString overrides a #noThrow function, so nothing may escape:
            // String.startsWith can throw, and a printer that throws while
            // reporting another failure loses the original error.
            try {
                // scp-like ssh paths are relative (no leading "/") - insert the
                // separator so the display doesn't fuse port and path
                // ("ssh://host:22anderskjeldsen/..." -> "ssh://host:22/anderskjeldsen/...").
                var sep = ""
                if (!this.path.startsWith("/")) {
                    sep = "/"
                }
                return this.scheme + "://" + this.host + ":" + this.port.toString() + sep + this.path
            } catch (e: Exception) {
                return "<unprintable git url>"
            }
        }

        // Parse `http(s)://host[:port]/path` - returns null if the URL
        // can't be understood. We're intentionally strict; the smart-HTTP
        // transport is the only one wired up so far.
        static fun parse(raw: String): GitUrl {
            var s = raw.trim()
            var scheme = ""
            var rest = ""

            var schemeEnd = s.indexOf("://")
            if (schemeEnd < 0) {
                // No `scheme://` - accept git's scp-like ssh shorthand,
                // `[user@]host:path` (the `:` separates host from path,
                // NOT a port). Anything else is unsupported.
                return GitUrl.parseScpLike(s)
            }
            scheme = s.substring(0UI, schemeEnd.toUInt()).toLowerCase()
            var afterScheme = (schemeEnd + 3).toUInt()
            rest = s.substringToEnd(afterScheme)

            if (scheme != "http" && scheme != "https" && scheme != "ssh") {
                throw new Exception("Only http/https/ssh remotes are supported, got: " + scheme)
            }

            var userInfo = ""
            var atIndex = rest.indexOf("@")
            var slashIndex = rest.indexOf("/")
            // userinfo only counts if the @ comes before the path slash
            if (atIndex >= 0 && (slashIndex < 0 || atIndex < slashIndex)) {
                userInfo = rest.substring(0UI, atIndex.toUInt())
                rest = rest.substringToEnd((atIndex + 1).toUInt())
                slashIndex = rest.indexOf("/")
            }

            var hostAndPort = rest
            var path = "/"
            if (slashIndex >= 0) {
                hostAndPort = rest.substring(0UI, slashIndex.toUInt())
                path = rest.substringToEnd(slashIndex.toUInt())
            }

            // Strip a trailing slash on the path so we can append cleanly.
            while (path.length() > 1 && path.endsWith("/")) {
                path = path.substring(0UI, (path.length() - 1).toUInt())
            }

            var host = hostAndPort
            var port = 443
            if (scheme == "http") {
                port = 80
            } else if (scheme == "ssh") {
                port = 22
            }
            var colon = hostAndPort.indexOf(":")
            if (colon >= 0) {
                host = hostAndPort.substring(0UI, colon.toUInt())
                var portStr = hostAndPort.substringToEnd((colon + 1).toUInt())
                port = Int.parse(portStr)
            }

            return new GitUrl(scheme, host, port, path, userInfo)
        }

        // Parse git's scp-like ssh shorthand: `[user@]host:path`,
        // e.g. `git@github.com:anderskjeldsen/am-git.git`. The path is
        // relative to the remote user's home (no leading slash), which
        // git-upload-pack resolves fine. Default port 22.
        private static fun parseScpLike(s: String): GitUrl {
            var colon = s.indexOf(":")
            if (colon < 0) {
                throw new Exception("Unrecognised git URL (no scheme, no host:path): " + s)
            }
            var hostPart = s.substring(0UI, colon.toUInt())
            var path = s.substringToEnd((colon + 1).toUInt())

            // A slash before the colon means this isn't host:path - most
            // likely a local filesystem path, which we don't clone from.
            if (hostPart.indexOf("/") >= 0) {
                throw new Exception("Unrecognised git URL: " + s)
            }

            var userInfo = ""
            var at = hostPart.indexOf("@")
            if (at >= 0) {
                userInfo = hostPart.substring(0UI, at.toUInt())
                hostPart = hostPart.substringToEnd((at + 1).toUInt())
            }

            // Trim a trailing slash on the path so appends stay clean.
            while (path.length() > 1 && path.endsWith("/")) {
                path = path.substring(0UI, (path.length() - 1).toUInt())
            }
            return new GitUrl("ssh", hostPart, 22, path, userInfo)
        }

        // Pull a sensible repository name out of the path - last path
        // segment, with any trailing `.git` stripped. Used as the default
        // target directory for `clone`.
        fun repositoryName(): String {
            var p = this.path
            // strip trailing /
            while (p.length() > 0 && p.endsWith("/")) {
                p = p.substring(0UI, (p.length() - 1).toUInt())
            }
            var lastSlash = p.lastIndexOf("/")
            var name = p
            if (lastSlash >= 0) {
                name = p.substringToEnd((lastSlash + 1).toUInt())
            }
            if (name.endsWith(".git")) {
                name = name.substring(0UI, (name.length() - 4).toUInt())
            }
            return name
        }
    }
}
